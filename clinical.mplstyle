# ==============================================================================
# PIPETTE-VIZ // SILICON VALLEY & CLINICAL AI VISUALIZATION ENGINE
# Author: Mateusz Jakubowski (@MatthewJakubowski) | #FromPipetteToPython
# ==============================================================================

# --- 1. CANVAS & HIGH-DPI DISPLAY (Super AMOLED & Retina Optimized) ---
figure.figsize        : 10, 5.8
figure.dpi            : 130
figure.facecolor      : FFFFFF
figure.edgecolor      : FFFFFF
figure.autolayout     : False

# --- 2. PUBLICATION-GRADE EXPORT ---
savefig.dpi           : 300
savefig.format        : png
savefig.bbox          : tight
savefig.pad_inches    : 0.25
savefig.facecolor     : FFFFFF

# --- 3. EDITORIAL TYPOGRAPHY ---
font.family           : sans-serif
font.sans-serif       : Inter, Roboto, DejaVu Sans, Arial, Helvetica
font.size             : 11
text.color            : 0F172A
axes.titlesize        : 14
axes.titleweight      : bold
axes.titlepad         : 22
axes.titlelocation    : left
axes.labelsize        : 11
axes.labelweight      : bold
axes.labelpad         : 10
axes.labelcolor       : 1E293B
xtick.labelsize       : 10
ytick.labelsize       : 10
xtick.color           : 475569
ytick.color           : 475569
xtick.major.size      : 4
ytick.major.size      : 4

# --- 4. MINIMALIST GEOMETRY (Zero Chartjunk) ---
axes.facecolor        : FFFFFF
axes.edgecolor        : CBD5E1
axes.linewidth        : 1.1
axes.spines.top       : False
axes.spines.right     : False
axes.axisbelow        : True

# --- 5. PRECISION GRID ---
axes.grid             : True
grid.color            : E2E8F0
grid.linestyle        : --
grid.linewidth        : 0.75
grid.alpha            : 0.75

# --- 6. SEMANTIC ML & CLINICAL COLOR CYCLE ---
# [0] #005A9C - Cobalt Blue    : Train Curve / Primary Model / Baseline Signal
# [1] #D9534F - Crimson Red    : Validation Error / CITO Alert / Decision Boundary
# [2] #2A9D8F - Clinical Teal  : Test Set / Reference Norm / Generalization Target
# [3] #E76F51 - Amber Coral    : Hyperparameter Shift / Warning / Regularization
# [4] #6C5B7B - Deep Violet    : Latent Space / Neural Layer / SHAP Feature Impact
# [5] #64748B - Cool Slate     : Baseline Dummy Classifier / Control Cohort / Noise
axes.prop_cycle       : cycler('color', ['005A9C', 'D9534F', '2A9D8F', 'E76F51', '6C5B7B', '64748B'])

# --- 7. MATRICES, HEATMAPS & TENSORS (Scikit-Learn & Deep Learning Ready) ---
image.cmap            : viridis

# --- 8. LINES, SCATTERS & HISTOGRAMS ---
lines.linewidth       : 2.3
lines.markersize      : 6.5
lines.markeredgewidth : 1.2
patch.edgecolor       : FFFFFF
patch.force_edgecolor : True

# --- 9. CLEAN LEGEND ---
legend.frameon        : True
legend.framealpha     : 0.95
legend.facecolor      : FFFFFF
legend.edgecolor      : E2E8F0
legend.fontsize       : 10
legend.title_fontsize : 10
legend.loc            : best
